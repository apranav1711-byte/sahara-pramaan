{
  
  "$schema": "https://openapi.vercel.sh/vercel.json",
  
  "framework": "vite",
  
  "buildCommand": "pnpm build:vercel",
  
  "outputDirectory": "dist/public",
  
  "rewrites": [
    
    {
      
      "source": "/api/trpc/:path*",
      
      "destination": "/api/[...path]?trpcPath=:path*"
      
    }
    
  ]
  
}












